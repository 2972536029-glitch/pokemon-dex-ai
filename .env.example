# AI chat server configuration — copy to .env.local and fill in.
# .env.local is git-ignored; NEVER commit real keys.

# 智谱 AI 平台 (https://open.bigmodel.cn) 的 API Key — glm-4-flash 免费
GLM_API_KEY=

# 可选:模型与网关(默认如下)
# GLM_MODEL=glm-4-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 服务端口(默认 5178)
# PORT=5178

# 置 1 强制演示模式(不调真实模型,工具仍走真实 PokeAPI);未配 key 时自动生效
# MOCK_LLM=1
